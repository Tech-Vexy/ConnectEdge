# ConnectEdge Environment Configuration Example
# Copy this file to .env and update with your values

# Relay Server URL (Required)
# After deploying the Cloudflare Worker, update this with your worker URL
EXPO_PUBLIC_RELAY_URL=https://connectedge-relay.YOUR-SUBDOMAIN.workers.dev

# Development Mode (Optional)
# Uncomment to enable debug logging
# EXPO_PUBLIC_DEV_MODE=true

# Deploy Instructions:
# 1. cd worker
# 2. npx wrangler deploy
# 3. Copy the output URL to EXPO_PUBLIC_RELAY_URL above
# 4. Restart Expo: npm start -- --clear
